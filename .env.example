# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (Google Cloud Console). Same client ID/secret are also
# entered in Supabase -> Authentication -> Providers -> Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=



# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Vercel cron sends this as a Bearer token: openssl rand -hex 24
CRON_SECRET=

# Comma-separated Google emails allowed to sign in
ALLOWED_EMAILS=
# Digest timezone
APP_TIMEZONE=Europe/Istanbul
